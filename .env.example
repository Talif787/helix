# Copy this file to .env and adjust as needed. The .env file is gitignored.
# Load it into your shell before running the node:
#   set -a; source .env; set +a
#   make run

# Directory for the write-ahead log (and, from Phase 2, SSTables).
HELIX_DATA_DIR=./data

# Fsync on every write. true is safest; false is faster and still durable at Close.
HELIX_SYNC_WRITES=true

# Input size limits, in bytes.
HELIX_MAX_KEY_BYTES=65536
HELIX_MAX_VALUE_BYTES=1048576

# Memtable size that triggers a flush to an SSTable, in bytes.
HELIX_MEMTABLE_MAX_BYTES=67108864

# Block cache size, in bytes. Data blocks read from SSTables are cached (LRU) up to
# this many bytes so hot reads avoid disk. Set small to minimize memory.
HELIX_BLOCK_CACHE_BYTES=8388608

# Number of similarly sized SSTables that triggers a size-tiered compaction. Lower
# values compact more aggressively (fewer tables, more write amplification). Min 2.
HELIX_COMPACTION_MIN_THRESHOLD=4

# Logging. Level is one of debug, info, warn, error. Format is json or text.
# text is friendlier for local reading; json is better for aggregation.
HELIX_LOG_LEVEL=info
HELIX_LOG_FORMAT=text
